ENV=development
PORT=8002

# Comma-separated keys for regular API access (X-API-KEY header)
ALLOWED_API_KEYS=
# Comma-separated keys for admin/operator endpoints (topup, payouts, etc.)
# Admin keys are also valid regular keys — no need to list them in both vars.
ADMIN_API_KEYS=

DATABASE_DSN=
REDIS_URL=

# ------ Biteship
BITESHIP_API_KEY=
BITESHIP_BASE_URL=
BITESHIP_WEBHOOK_SIGNATURE_KEY=
BITESHIP_WEBHOOK_SIGNATURE_VALUE=

# ------ Wilayah.id
WILAYAH_BASE_URL=https://wilayah.id

# ------ Xendit
XENDIT_API_KEY=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=

# ------ Tokokarya
TOKOKARYA_URL=
TOKOKARYA_API_KEY=

# ---- Geoapif
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=

# ---- Doku payment Gateway
DOKU_CLIENT_ID=
DOKU_BASE_URL=
DOKU_SECRET_KEY=
DOKU_API_KEY=

# ---- PostHog Telemetry
POSTHOG_PROJECT_TOKEN=
POSTHOG_ENDPOINT=https://us.i.posthog.com
POSTHOG_SERVICE_NAME=connector-api