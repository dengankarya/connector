{"nodes": [{"id": "payment_doc_overview", "label": "Payment Module Overview", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_package_structure", "label": "Payment Package Structure", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 67", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_domain_layer", "label": "Domain Layer (internal/payment/domain/)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_repository_layer", "label": "Repository Layer (internal/payment/repository/)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_webhook_processor", "label": "Webhook Processor (webhook/processor.go)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 97", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_webhook_handler", "label": "Webhook Handler (webhook/handler.go)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 98", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_replay_service", "label": "Replay Service (webhook/replay.go)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_payment_service", "label": "Payment Service (service/payment.go)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_payout_service", "label": "Payout Service (service/payout.go)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 105", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_ledger_service", "label": "Ledger Service (ledger/service.go)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_state_machine", "label": "Payment Transaction State Machine", "file_type": "rationale", "source_file": "docs/payment-module.md", "source_location": "line 123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terminal states (expired, failed, refunded, voided) accept no further transitions. ErrAlreadyInState is idempotent (treat as no-op). ErrInvalidStatusTransition means a bug. State machine enforces business rules at domain layer, independent of DB."}, {"id": "payment_doc_double_entry_ledger", "label": "Double-Entry Ledger", "file_type": "concept", "source_file": "docs/payment-module.md", "source_location": "line 256", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Append-only, immutable ledger. Every financial event creates a balanced journal (sum of debits = sum of credits). LedgerJournal.Validate() panics before DB write on imbalance. reference_id unique constraint provides idempotency via ON CONFLICT DO NOTHING."}, {"id": "payment_doc_ledger_accounts", "label": "Ledger Account Types (escrow/merchant_payable/platform_fee/payout/refund)", "file_type": "concept", "source_file": "docs/payment-module.md", "source_location": "line 263", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_payout_system", "label": "Payout System", "file_type": "concept", "source_file": "docs/payment-module.md", "source_location": "line 316", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_xenplatform_routing", "label": "XenPlatform Sub-Account Routing (for-user-id)", "file_type": "concept", "source_file": "docs/payment-module.md", "source_location": "line 338", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The platform's main API key is used for all calls but individual operations are scoped to a merchant's sub-account via for-user-id header. Transfer intentionally omits this header as it is a platform-level operation routing funds between main and sub-account."}, {"id": "payment_doc_webhook_replay_retry", "label": "Webhook Replay & Retry Mechanism", "file_type": "concept", "source_file": "docs/payment-module.md", "source_location": "line 491", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-layer retry: asynq automatic exponential backoff (5 attempts), job-based retry every 10min for failed events, and manual force-replay API. Replay is always safe because SELECT FOR UPDATE + state machine + ledger idempotency prevent double-application."}, {"id": "payment_doc_background_jobs", "label": "Background Jobs (expire_payments + retry_webhooks)", "file_type": "code", "source_file": "docs/payment-module.md", "source_location": "line 539", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_db_schema_transactions", "label": "payment_transactions Table", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 839", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_db_schema_webhook_events", "label": "payment_webhook_events Table", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 865", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_db_schema_ledger", "label": "payment_ledger_entries Table", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 880", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_db_schema_payouts", "label": "payment_payouts Table", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 894", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_db_schema_idempotency", "label": "payment_idempotency_keys Table", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 899", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_security_design", "label": "Security Design", "file_type": "rationale", "source_file": "docs/payment-module.md", "source_location": "line 752", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Xendit uses static shared token validated with hmac.Equal for constant-time comparison (prevents timing side-channel). Signature failures return 200 silently to avoid leaking info to attacker. Tenant isolation via TenantID check returns ErrNotFound (not 403) to avoid leaking existence of cross-tenant resources."}, {"id": "payment_doc_select_for_update", "label": "SELECT FOR UPDATE Locking Pattern", "file_type": "rationale", "source_file": "docs/payment-module.md", "source_location": "line 195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two locks acquired in webhook processing: (1) webhook event row lock prevents duplicate workers on same event; (2) transaction row lock prevents concurrent webhooks racing on same invoice. Both held in single READ COMMITTED transaction."}, {"id": "payment_doc_observability", "label": "Observability & Structured Logging (logrus JSON)", "file_type": "concept", "source_file": "docs/payment-module.md", "source_location": "line 785", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_failure_scenarios", "label": "Failure Scenarios & Recovery", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 996", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_adding_provider", "label": "Adding a New Payment Provider Guide", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 902", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_xendit_event_types", "label": "Supported Xendit Event Types", "file_type": "document", "source_file": "docs/payment-module.md", "source_location": "line 237", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "payment_doc_idempotency_pattern", "label": "Idempotency Pattern", "file_type": "rationale", "source_file": "docs/payment-module.md", "source_location": "line 296", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotency enforced at multiple layers: domain ErrAlreadyInState, ledger reference_id UNIQUE index with ON CONFLICT DO NOTHING, payment_idempotency_keys table for API dedup, and webhook provider_event_id ON CONFLICT DO NOTHING at ingest. Reference ID format: txn:{transaction_id}:{event}:{account}."}], "edges": [{"source": "payment_doc_webhook_processor", "target": "claude_webhook_pipeline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/payment-module.md", "source_location": "line 97", "weight": 1.0}, {"source": "payment_doc_webhook_handler", "target": "claude_asynq_worker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/payment-module.md", "source_location": "line 98", "