{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "doku-mcp-server": {
      "type": "remote",
      "url": "https://api-sandbox.doku.com/doku-mcp-server/mcp",
      "headers": {
        "Client-Id": "{env:DOKU_CLIENT_ID}",
        "Authorization": "{env:DOKU_MCP_AUTH}"
      }
    }
  }
}
